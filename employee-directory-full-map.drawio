                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="49" value="FIXED — Landmark disappearing&#xa;Was hidden purely by selected country.&#xa;Now only auto-hides while genuinely&#xa;empty — typed text no longer vanishes&#xa;when the country changes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=10;align=left;spacing=6;verticalAlign=top;" parent="1" vertex="1">
