                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="47" value="FIXED — per-step Save&#xa;Submit used to re-validate ALL 9 steps&#xa;before saving anything. A stale problem&#xa;on an untouched step silently blocked&#xa;every save. Now only the step you&#39;re&#xa;on gates Save." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=10;align=left;spacing=6;verticalAlign=top;" parent="1" vertex="1">
