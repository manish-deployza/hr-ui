                <mxCell id="45" value="FIXED — stepper ticks&#xa;A step ticks only once its own fields&#xa;are valid AND non-empty. An all-optional&#xa;step no longer ticks itself before&#xa;anything is typed into it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=10;align=left;spacing=6;verticalAlign=top;" parent="1" vertex="1">
