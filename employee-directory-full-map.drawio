                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="51" value="FIXED — masked-field corruption&#xa;bankAccount/nationalId/taxId/passport&#xa;always come back masked (&#39;•••• 1234&#39;),&#xa;even to ORG_ADMIN. Edit form now shows&#xa;the mask as a placeholder only; blank&#xa;→ omitted from PATCH (never overwrites&#xa;the real value)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=10;align=left;spacing=6;verticalAlign=top;" parent="1" vertex="1">
